# Configuração do Servidor
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# MongoDB Atlas
# Obtenha a string em: https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://usuario:senha@cluster0.mongodb.net/api_auth?retryWrites=true&w=majority

# JWT Secret (mude para algo muito seguro em produção!)
# Gere um segredo forte: https://www.uuidgenerator.net/
JWT_SECRET=sua_chave_secreta_muito_forte_e_segura_aqui_minimo_32_caracteres
